<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:SimplexMethodApp.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="viewmodel:MainViewModel"
             x:Class="SimplexMethodApp.MainPage"
             Title="Simplex Method App">

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <ScrollView BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight},
                                                   Dark={StaticResource BackgroundDark}}">
        <VerticalStackLayout Padding="16,14,16,30" Spacing="0">

            <!-- ─────────────────────────────────────────────────────────
                 HEADER
                 ───────────────────────────────────────────────────────── -->
            <VerticalStackLayout Spacing="4" Margin="0,0,0,20">
                <Label Text="Симплекс Метод"
                       FontSize="26"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource Primary}" />
                <Label Text="Розв'язання задач лінійного програмування"
                       FontSize="13"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource TextSecondary}" />
            </VerticalStackLayout>

            <!-- ─────────────────────────────────────────────────────────
                 CARD 1 — ПАРАМЕТРИ ЗАДАЧІ
                 ───────────────────────────────────────────────────────── -->
            <Border Style="{StaticResource Card}" IsEnabled="{Binding IsNotBusy}">
                <VerticalStackLayout Spacing="7">

                    <Label Text="⚙  Параметри задачі"
                           Style="{StaticResource SectionTitle}" />

                    <!-- ── Кількість змінних ── -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Кількість змінних"
                               FontSize="13"
                               TextColor="{StaticResource TextSecondary}" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">

                            <Picker Grid.Column="0"
                                    Style="{StaticResource CompactPicker}"
                                    ItemsSource="{Binding VariableCountOptions}"
                                    SelectedItem="{Binding SelectedVariableOption}"
                                    
                                    Title="Оберіть кількість..." />

                            <!-- Поле для свого значення (IsVisible прив'язано) -->
                            <Border Grid.Column="1"
                                    Stroke="{StaticResource Primary}"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 8"
                                    MinimumWidthRequest="100"
                                    IsVisible="{Binding IsCustomVariableCount}">
                                <Entry Text="{Binding CustomVariableCount}"
                                       Placeholder="N > 20"
                                       Keyboard="Numeric"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"
                                       HorizontalOptions="Fill" 
                                       VerticalOptions="Fill"
                                       TextColor="{AppThemeBinding
                                           Light={StaticResource TextPrimary},
                                           Dark={StaticResource TextPrimaryDark}}"
                                       BackgroundColor="Transparent" />
                            </Border>

                        </Grid>
                    </VerticalStackLayout>

                    <BoxView Style="{StaticResource Divider}" />

                    <!-- ── Кількість обмежень ── -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Кількість обмежень"
                               FontSize="13"
                               TextColor="{StaticResource TextSecondary}" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">

                            <Picker Grid.Column="0"
                                    Style="{StaticResource CompactPicker}"
                                    ItemsSource="{Binding ConstraintCountOptions}"
                                    SelectedItem="{Binding SelectedConstraintOption}"
                                    Title="Оберіть кількість..." />

                            <Border Grid.Column="1"
                                    Stroke="{StaticResource Primary}"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 8"
                                    MinimumWidthRequest="100"
                                    IsVisible="{Binding IsCustomConstraintCount}">
                                <Entry Text="{Binding CustomConstraintCount}"
                                       Placeholder="M > 20"
                                       Keyboard="Numeric"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"
                                       HorizontalOptions="Fill" 
                                       VerticalOptions="Fill"
                                       TextColor="{AppThemeBinding
                                           Light={StaticResource TextPrimary},
                                           Dark={StaticResource TextPrimaryDark}}"
                                       BackgroundColor="Transparent" />
                            </Border>

                        </Grid>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- ─────────────────────────────────────────────────────────
                 CARD 2 — ЦІЛЬОВА ФУНКЦІЯ
                 ───────────────────────────────────────────────────────── -->
            <Border Style="{StaticResource Card}" IsEnabled="{Binding IsNotBusy}">
                <VerticalStackLayout Spacing="10">

                    <Label Text="🎯  Цільова функція"
                           Style="{StaticResource SectionTitle}" />

                    
                        <!--Рядок вигляду:
                        F(x) = [c1]x₁ + [c2]x₂ + [c3]x₃ + ... → [max▼]

                        ScrollView горизонтальний, щоб не обрізало при багатьох змінних.
                        FlexLayout містить BindableLayout з динамічними термами.-->
                    
                    <ScrollView Orientation="Horizontal">
                        <HorizontalStackLayout Spacing="0" VerticalOptions="Center" Margin="0,4">

                             <!--"F(x) ="--> 
                            <Label Text="F(x) ="
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"
                                   VerticalOptions="Center"
                                   Margin="0,0,6,0" />

                             <!--Динамічні члени: [cᵢ] xᵢ +-->
                            <HorizontalStackLayout Spacing="0"
                                                   VerticalOptions="Center"
                                                   BindableLayout.ItemsSource="{Binding ObjectiveCoefficients}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodel:ObjTermViewModel">
                                        
                                            <!--ObjTermViewModel:
                                                Value         : string  ← Entry
                                                VariableLabel : string  → "x₁", "x₂", ...
                                                Separator     : string  → " + " або ""-->

                                        <HorizontalStackLayout Spacing="0"
                                                               VerticalOptions="Center"
                                                               Margin="0,0,2,0">

                                            <!--Коефіцієнт cᵢ--> 
                                            <Border Stroke="{StaticResource BorderLight}"
                                                    StrokeThickness="1"
                                                    StrokeShape="RoundRectangle 6"
                                                    MinimumWidthRequest="20">
                                                <Entry Style="{StaticResource CoeffEntry}"
                                                       Text="{Binding Value}"
                                                       HorizontalTextAlignment="Center"
                                                       VerticalTextAlignment="Center"
                                                       Placeholder="0" />
                                            </Border>

                                             <!--xᵢ--> 
                                            <Label Text="{Binding VariableLabel}"
                                                   Style="{StaticResource BodyText}"
                                                   FontAttributes="Italic"
                                                   Margin="3,0,0,0" />

                                             <!--" + " або пусто (між термами)--> 
                                            <Label Text="{Binding Separator}"
                                                   Style="{StaticResource BodyText}"
                                                   Margin="3,0" />
                                        </HorizontalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>

                             <!--"→"--> 
                            <Label Text=" →"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   TextColor="{StaticResource TextSecondary}"
                                   Margin="4,0" />

                             <!--max / min Picker--> 
                            <Border Stroke="{StaticResource Primary}"
                                    StrokeThickness="2"
                                    StrokeShape="RoundRectangle 8">
                                <Picker Style="{StaticResource CompactPicker}"
                                        ItemsSource="{Binding OptimizationOptions}"
                                        SelectedItem="{Binding SelectedOptimizationOption}"
                                        WidthRequest="85"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource Primary}" />
                            </Border>

                        </HorizontalStackLayout>
                    </ScrollView>

                </VerticalStackLayout>
            </Border>

            <!-- ─────────────────────────────────────────────────────────
                 CARD 3 — СИСТЕМА ОБМЕЖЕНЬ
                 ───────────────────────────────────────────────────────── -->
            <Border Style="{StaticResource Card}" IsEnabled="{Binding IsNotBusy}">
                <VerticalStackLayout Spacing="10">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="📋  Система обмежень"
                               Style="{StaticResource SectionTitle}"
                               Margin="0" />
                        <!-- Підказка про умову невід'ємності -->
                        <Label Grid.Column="1"
                               Text="xᵢ ≥ 0"
                               FontSize="13"
                               FontAttributes="Italic"
                               TextColor="{StaticResource TextSecondary}"
                               VerticalOptions="Center" />
                    </Grid>

                    <!--
                        Кожен рядок обмежень:
                        { [a₁]x₁ + [a₂]x₂ + ... [≤▼] [b] }
                    -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">

                        <!-- Велика фігурна дужка зліва -->
                        <Label Grid.Column="0"
                               Text="{}{"
                               FontSize="56"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               VerticalOptions="Center"
                               Margin="0,0,4,0" />

                        <!-- Список обмежень (BindableLayout на VerticalStackLayout) -->
                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="10"
                                             BindableLayout.ItemsSource="{Binding Constraints}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="viewmodel:ConstraintRowViewModel">
                                    <!--
                                        ConstraintRowViewModel:
                                            Coefficients : ObservableCollection<ConstraintCoeffViewModel>
                                            SignOptions   : List<string> { "≤", "=", "≥" }
                                            SelectedSign  : string
                                            RhsValue      : string
                                    -->
                                    <ScrollView Orientation="Horizontal">
                                        <HorizontalStackLayout Spacing="0" VerticalOptions="Center" Margin="0,4">

                                            <!-- Коефіцієнти aᵢⱼ xⱼ + -->
                                            <FlexLayout Direction="Row"
                                                        Wrap="NoWrap"
                                                        AlignItems="Center"
                                                        BindableLayout.ItemsSource="{Binding Coefficients}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="viewmodel:ConstraintCoeffViewModel">
                                                        <!--
                                                            ConstraintCoeffViewModel:
                                                                Value         : string
                                                                VariableLabel : string
                                                                Separator     : string
                                                        -->
                                                        <HorizontalStackLayout Spacing="0"
                                                                               VerticalOptions="Center"
                                                                               Margin="0,0,2,0">

                                                            <Border Stroke="{StaticResource BorderLight}"
                                                                    StrokeThickness="1"
                                                                    StrokeShape="RoundRectangle 6" >
                                                                <Entry Style="{StaticResource CoeffEntry}"
                                                                       Text="{Binding Value}"
                                                                       HorizontalTextAlignment="Center"
                                                                       VerticalTextAlignment="Center"
                                                                       Placeholder="0" />
                                                            </Border>

                                                            <Label Text="{Binding VariableLabel}"
                                                                   Style="{StaticResource BodyText}"
                                                                   FontAttributes="Italic"
                                                                   Margin="3,0,0,0" />

                                                            <Label Text="{Binding Separator}"
                                                                   Style="{StaticResource BodyText}"
                                                                   Margin="3,0" />
                                                        </HorizontalStackLayout>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </FlexLayout>

                                            <!-- Знак обмеження: ≤ / = / ≥ -->
                                            <Border Stroke="{StaticResource Primary}"
                                                    StrokeThickness="1.5"
                                                    StrokeShape="RoundRectangle 8"
                                                    Margin="6,0">
                                                <Picker Style="{StaticResource CompactPicker}"
                                                        ItemsSource="{Binding SignOptions}"
                                                        SelectedItem="{Binding SelectedSign}"
                                                        WidthRequest="78"
                                                        TextColor="{StaticResource Primary}"
                                                        FontAttributes="Bold" />
                                            </Border>

                                            <!-- Права частина bᵢ -->
                                            <Border Stroke="{StaticResource BorderLight}"
                                                    StrokeThickness="1"
                                                    StrokeShape="RoundRectangle 6">
                                                <Entry Style="{StaticResource CoeffEntry}"
                                                       Text="{Binding RhsValue}"
                                                       Placeholder="b"
                                                       HorizontalTextAlignment="Center"
                                                       VerticalTextAlignment="Center"
                                                       WidthRequest="68" />
                                            </Border>

                                        </HorizontalStackLayout>
                                    </ScrollView>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- ─────────────────────────────────────────────────────────
                 КНОПКИ ДІЇ
                 ───────────────────────────────────────────────────────── -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,0,0,14">

                <Button Grid.Column="0"
                        Text="🔄 Скинути"
                        Command="{Binding ClearCommand}"
                        Style="{StaticResource SecondaryButton}" />

                <Button Grid.Column="1"
                        Text="▶  Розв'язати"
                        Command="{Binding SolveCommand}"
                        IsVisible="{Binding SolveCommand.IsRunning, Converter={StaticResource InvertedBoolConverter}}"
                        Style="{StaticResource PrimaryButton}" />

                <Button Grid.Column="1"
                        Text="⬜️ Скасувати"
                        BackgroundColor="{StaticResource Danger}"
                        Command="{Binding SolveCancelCommand}"
                        IsVisible="{Binding SolveCommand.IsRunning}"
                        Style="{StaticResource PrimaryButton}" />

            </Grid>

            <!-- ─────────────────────────────────────────────────────────
                 CARD 4 — РОЗВ'ЯЗАННЯ (показується після натискання "Розв'язати")
                 ───────────────────────────────────────────────────────── --><!--
            <Border Style="{StaticResource Card}"
                    IsVisible="{Binding HasSolution}">
                <VerticalStackLayout Spacing="14">

                    <Label Text="📊  Розв'язання"
                           Style="{StaticResource SectionTitle}" />

                    --><!-- ── Повідомлення про помилку ── --><!--
                    <Border BackgroundColor="#FEF2F2"
                            Stroke="#FCA5A5"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            Padding="14,10"
                            IsVisible="{Binding HasError}">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="⚠"
                                   FontSize="16"
                                   TextColor="{StaticResource Danger}"
                                   VerticalOptions="Center" />
                            <Label Text="{Binding ErrorMessage}"
                                   FontSize="13"
                                   TextColor="{StaticResource Danger}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    --><!-- ── Кроки симплекс-методу ── --><!--
                    <VerticalStackLayout Spacing="12"
                                         BindableLayout.ItemsSource="{Binding SolutionSteps}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                --><!--
                                    SolutionStepViewModel:
                                        Title       : string  → "Початковий крок" / "Ітерація 1"
                                        Description : string  → пояснення дій на цьому кроці
                                        HasTable    : bool
                                        TableRows   : ObservableCollection<SimplexTableRowViewModel>
                                            SimplexTableRowViewModel:
                                                BasisVar   : string
                                                Cb         : string
                                                P          : string
                                                Cells      : ObservableCollection<CellViewModel>
                                                    CellViewModel:
                                                        Value        : string
                                                        IsHighlighted: bool  → опорний елемент
                                                        IsEntering   : bool  → стовпець, що входить
                                                        IsLeaving    : bool  → рядок, що виходить
                                                Q          : string
                                                IsEstimate : bool  → останній рядок (оцінки)
                                --><!--
                                <Border BackgroundColor="{AppThemeBinding
                                            Light=#F8FAFC, Dark=#162030}"
                                        Stroke="{AppThemeBinding
                                            Light={StaticResource BorderLight},
                                            Dark={StaticResource BorderDark}}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="14">
                                    <VerticalStackLayout Spacing="8">

                                        --><!-- Заголовок кроку --><!--
                                        <Label Text="{Binding Title}"
                                               FontAttributes="Bold"
                                               FontSize="14"
                                               TextColor="{StaticResource Primary}" />

                                        --><!-- Опис / пояснення --><!--
                                        <Label Text="{Binding Description}"
                                               FontSize="12"
                                               LineBreakMode="WordWrap"
                                               TextColor="{AppThemeBinding
                                                   Light={StaticResource TextSecondary},
                                                   Dark={StaticResource TextSecondaryDark}}"
                                               IsVisible="{Binding HasDescription}" />

                                        --><!-- ─── Симплекс-таблиця ─── -->
                                        <!--
                                            ПРИМІТКА: Таблиця будується у code-behind або через
                                            ContentView/CustomView, бо кількість стовпців динамічна.
                                            Тут залишено ScrollView як контейнер-плейсхолдер.
                                            Рекомендована реалізація: Grid програмно або DataGrid
                                            від CommunityToolkit.
                                        --><!--
                                        <ScrollView Orientation="Horizontal"
                                                    HorizontalScrollBarVisibility="Always"
                                                    IsVisible="{Binding HasTable}">
                                            --><!--
                                                Вставити сюди кастомний SimplexTableView:
                                                <views:SimplexTableView
                                                    Rows="{Binding TableRows}" />
                                            --><!--
                                            <ContentView x:Name="TablePlaceholder"
                                                         BindingContext="{Binding}"
                                                         MinimumWidthRequest="300" />
                                        </ScrollView>

                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    --><!-- ── Оптимальний розв'язок (фінальний блок) ── --><!--
                    <Border BackgroundColor="{AppThemeBinding
                                Light=#EFF6FF, Dark=#0D2744}"
                            Stroke="{StaticResource Primary}"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 12"
                            Padding="16"
                            IsVisible="{Binding HasOptimalSolution}">
                        <VerticalStackLayout Spacing="8">

                            <HorizontalStackLayout Spacing="8">
                                <Label Text="✅"
                                       FontSize="18"
                                       VerticalOptions="Center" />
                                <Label Text="Оптимальний розв'язок"
                                       FontAttributes="Bold"
                                       FontSize="15"
                                       TextColor="{StaticResource Primary}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <BoxView Style="{StaticResource Divider}" Margin="0,0" />

                            --><!-- F* = ... --><!--
                            <Label Text="{Binding OptimalValueText}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding
                                       Light={StaticResource TextPrimary},
                                       Dark={StaticResource TextPrimaryDark}}" />

                            --><!-- x₁ = ...,  x₂ = ..., ... --><!--
                            <Label Text="{Binding OptimalVariablesText}"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding
                                       Light={StaticResource TextSecondary},
                                       Dark={StaticResource TextSecondaryDark}}" />

                        </VerticalStackLayout>
                    </Border>

                    --><!-- ── Кнопка копіювання результату ── --><!--
                    <Button Text="📋 Копіювати результат"
                            Command="{Binding CopyResultCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Primary}"
                            FontSize="13"
                            HorizontalOptions="End"
                            HeightRequest="36"
                            IsVisible="{Binding HasOptimalSolution}" />

                </VerticalStackLayout>
            </Border>-->

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
