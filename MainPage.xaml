<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:SimplexMethodApp.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:controls="clr-namespace:SimplexMethodApp.Controls"
             x:DataType="viewmodel:MainViewModel"
             x:Class="SimplexMethodApp.MainPage"
             Title="Simplex Method App">

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <ScrollView BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight},
                                                   Dark={StaticResource BackgroundDark}}">
        <VerticalStackLayout Padding="16,14,16,30" Spacing="0">

            <!-- ─────────────────────────────────────────────────────────
                 HEADER
                 ───────────────────────────────────────────────────────── -->
            <VerticalStackLayout Spacing="4" Margin="0,0,0,20">
                <Label Text="Симплекс Метод"
                       FontSize="26"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource Primary}" />
                <Label Text="Розв'язання задач лінійного програмування"
                       FontSize="13"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource TextSecondary}" />
            </VerticalStackLayout>

            <!-- ─────────────────────────────────────────────────────────
                 CARD 1 — PROBLEM PARAMETERS
                 ───────────────────────────────────────────────────────── -->
            <Border Style="{StaticResource Card}" IsEnabled="{Binding IsNotBusy}">
                <VerticalStackLayout Spacing="7">

                    <Label Text="⚙  Параметри задачі"
                           Style="{StaticResource SectionTitle}" />

                    <!-- ── Number of variables ── -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Кількість змінних"
                               FontSize="13"
                               TextColor="{StaticResource TextSecondary}" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">

                            <Picker Grid.Column="0"
                                    Style="{StaticResource CompactPicker}"
                                    ItemsSource="{Binding VariableCountOptions}"
                                    SelectedItem="{Binding SelectedVariableOption}"
                                    Title="Оберіть кількість..." />

                            <Border Grid.Column="1"
                                    Stroke="{StaticResource Primary}"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 8"
                                    MinimumWidthRequest="100"
                                    IsVisible="{Binding IsCustomVariableCount}">
                                <controls:NumericEntry Text="{Binding CustomVariableCount}"
                                       Placeholder="N ≤ 20"
                                       Keyboard="Numeric"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"
                                       HorizontalOptions="Fill" 
                                       VerticalOptions="Fill"
                                       TextColor="{AppThemeBinding
                                           Light={StaticResource TextPrimary},
                                           Dark={StaticResource TextPrimaryDark}}"
                                       BackgroundColor="Transparent" />
                            </Border>

                        </Grid>
                    </VerticalStackLayout>

                    <BoxView Style="{StaticResource Divider}" />

                    <!-- ── Number of constraints ── -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Кількість обмежень"
                               FontSize="13"
                               TextColor="{StaticResource TextSecondary}" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">

                            <Picker Grid.Column="0"
                                    Style="{StaticResource CompactPicker}"
                                    ItemsSource="{Binding ConstraintCountOptions}"
                                    SelectedItem="{Binding SelectedConstraintOption}"
                                    Title="Оберіть кількість..." />

                            <Border Grid.Column="1"
                                    Stroke="{StaticResource Primary}"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 8"
                                    MinimumWidthRequest="100"
                                    IsVisible="{Binding IsCustomConstraintCount}">
                                <controls:NumericEntry Text="{Binding CustomConstraintCount}"
                                       Placeholder="M ≤ 20"
                                       Keyboard="Numeric"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"
                                       HorizontalOptions="Fill" 
                                       VerticalOptions="Fill"
                                       TextColor="{AppThemeBinding
                                           Light={StaticResource TextPrimary},
                                           Dark={StaticResource TextPrimaryDark}}"
                                       BackgroundColor="Transparent" />
                            </Border>

                        </Grid>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- ─────────────────────────────────────────────────────────
                 CARD 2 — OBJECTIVE FUNCTION
                 ───────────────────────────────────────────────────────── -->
            <Border Style="{StaticResource Card}" IsEnabled="{Binding IsNotBusy}">
                <VerticalStackLayout Spacing="10">

                    <Label Text="🎯  Цільова функція"
                           Style="{StaticResource SectionTitle}" />

                    <ScrollView Orientation="Horizontal">
                        <HorizontalStackLayout Spacing="0" VerticalOptions="Center" Margin="0,4">

                            <!--"F(x) ="-->
                            <Label Text="F(x) ="
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"
                                   VerticalOptions="Center"
                                   Margin="0,0,6,0" />

                            <!--[cᵢ] xᵢ +-->
                            <HorizontalStackLayout VerticalOptions="Center"
                                            BindableLayout.ItemsSource="{Binding ObjectiveCoefficients}">

                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodel:ObjTermViewModel">
                                        
                                        <!--ObjTermViewModel:
                                            Value         : string  ← Entry
                                            VariableLabel : string  → "x₁", "x₂", ...
                                            Separator     : string  → " + " or ""-->

                                        <HorizontalStackLayout Spacing="0"
                                                               VerticalOptions="Center" >
                                            
                                            <controls:NumericEntry Style="{StaticResource CoeffEntry}"
                                                       Text="{Binding Value}"
                                                       HorizontalTextAlignment="Center"
                                                       VerticalTextAlignment="Center"
                                                       Placeholder="c" />

                                            <Label Text="{Binding DisplayLabel}"
                                                   Style="{StaticResource BodyText}"
                                                   FontAttributes="Italic"
                                                   Margin="3,0,0,0" />

                                        </HorizontalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>

                            <!--"→"-->
                            <Label Text=" →"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   TextColor="{StaticResource TextSecondary}"
                                   Margin="4,0" />

                            <!--max / min Picker-->
                            <Border Stroke="{StaticResource Primary}"
                                    StrokeThickness="2"
                                    StrokeShape="RoundRectangle 8">
                                <Picker Style="{StaticResource CompactPicker}"
                                        ItemsSource="{Binding OptimizationOptions}"
                                        SelectedItem="{Binding SelectedOptimizationOption}"
                                        WidthRequest="85"
                                        FontAttributes="Bold"
                                        IsEnabled="{Binding IsNotBusy}"
                                        TextColor="{StaticResource Primary}" />
                            </Border>

                        </HorizontalStackLayout>
                    </ScrollView>

                </VerticalStackLayout>
            </Border>

            <!-- ─────────────────────────────────────────────────────────
                 CARD 3 — SYSTEM OF CONSTRAINTS
                 ───────────────────────────────────────────────────────── -->
            <Border Style="{StaticResource Card}" IsEnabled="{Binding IsNotBusy}">
                <VerticalStackLayout Spacing="10">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="📋  Система обмежень"
                               Style="{StaticResource SectionTitle}"
                               Margin="0" />
                        
                        <Label Grid.Column="1"
                               Text="xᵢ ≥ 0"
                               FontSize="13"
                               FontAttributes="Italic"
                               TextColor="{StaticResource TextSecondary}"
                               VerticalOptions="Center" />      
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">

                        <Label Grid.Column="0"
                               Text="{}{"
                               FontSize="56"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               VerticalTextAlignment="Center"
                               HorizontalTextAlignment="Center"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Padding="0,0,0,10"
                               Margin="0,0,4,0" />

                        <ScrollView Grid.Column="1" 
                                    Orientation="Both" 
                                    VerticalOptions="Center"
                                    MaximumHeightRequest="300"> 

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Constraints}"
                                     Spacing="12"
                                     Padding="0,0,10,0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodel:ConstraintRowViewModel">

                                        <HorizontalStackLayout Spacing="0" VerticalOptions="Center" Margin="0,4">

                                            <!-- Coefficients aᵢⱼ xⱼ + -->
                                            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Coefficients}" 
                                                       Spacing="0" 
                                                       VerticalOptions="Center">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="viewmodel:ConstraintCoeffViewModel">

                                                        <Grid ColumnDefinitions="Auto, Auto" ColumnSpacing="2" Margin="0,0,4,0">
                                                            <controls:NumericEntry Grid.Column="0"
                                                                       Style="{StaticResource CoeffEntry}"
                                                                       Text="{Binding Value}"
                                                                       HorizontalTextAlignment="Center"
                                                                       VerticalTextAlignment="Center"
                                                                       Placeholder="a" />
                                                            <Label Grid.Column="1"
                                                                   Text="{Binding DisplayLabel}"
                                                                   Style="{StaticResource BodyText}"
                                                                   FontAttributes="Italic"
                                                                   VerticalOptions="Center" />  
                                                        </Grid>

                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </HorizontalStackLayout>

                                            <!-- Sign: ≤ / = / ≥ -->
                                            <Border Stroke="{StaticResource Primary}"
                                                    StrokeThickness="1.5"
                                                    StrokeShape="RoundRectangle 8"
                                                    Margin="6,0">
                                                <Picker Style="{StaticResource CompactPicker}"
                                                        ItemsSource="{Binding SignOptions}"
                                                        SelectedItem="{Binding SelectedSign}"
                                                        WidthRequest="78"
                                                        TextColor="{StaticResource Primary}"
                                                        FontAttributes="Bold" />        
                                            </Border>

                                            <!-- Right-hand side bᵢ -->

                                                <controls:NumericEntry Style="{StaticResource CoeffEntry}"
                                                           Text="{Binding RhsValue}"
                                                           Placeholder="b"
                                                           HorizontalTextAlignment="Center"
                                                           VerticalTextAlignment="Center"
                                                           WidthRequest="68" />

                                        </HorizontalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                        </ScrollView>
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- ─────────────────────────────────────────────────────────
                 ACTIONS
                 ───────────────────────────────────────────────────────── -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,0,0,14">

                <Button Grid.Column="0"
                        Text="🔄 Скинути"
                        Command="{Binding ClearCommand}"
                        Style="{StaticResource SecondaryButton}" />

                <Button Grid.Column="1"
                        Text="▶  Розв'язати"
                        Command="{Binding SolveCommand}"
                        IsVisible="{Binding SolveCommand.IsRunning, Converter={StaticResource InvertedBoolConverter}}"
                        Style="{StaticResource PrimaryButton}" />

                <Button Grid.Column="1"
                        Text="⬜️ Скасувати"
                        BackgroundColor="{StaticResource Danger}"
                        Command="{Binding SolveCancelCommand}"
                        IsVisible="{Binding SolveCommand.IsRunning}"
                        Style="{StaticResource PrimaryButton}" />

            </Grid>

            <!-- ─────────────────────────────────────────────────────────
             CARD 4 — ERRORS
             ───────────────────────────────────────────────────────── -->
            <Border Style="{StaticResource Card}" 
                    BackgroundColor="{StaticResource DangerLight}"
                    IsVisible="{Binding HasValidationErrors}">
                
                <VerticalStackLayout Spacing="5">
                
                    <Label Text="❌  Помилки"
                           Style="{StaticResource SectionTitle}" />

                    <VerticalStackLayout Spacing="4"
                             BindableLayout.ItemsSource="{Binding ValidationErrors}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="•"
                                           TextColor="{StaticResource Danger}"
                                           FontSize="14"
                                           VerticalOptions="Center"/>
                                    <Label Text="{Binding .}"
                                           TextColor="{StaticResource Danger}"
                                           FontSize="13"
                                           VerticalOptions="Center"/>   
                                </HorizontalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
                
            </Border>

            <!-- ─────────────────────────────────────────────────────────
                 CARD 5 — SOLUTION STEPS & OPTIMAL SOLUTION
                 ───────────────────────────────────────────────────────── --><!--
            <Border Style="{StaticResource Card}"
                    IsVisible="{Binding HasSolution}">
                <VerticalStackLayout Spacing="14">

                    <Label Text="📊  Розв'язання"
                           Style="{StaticResource SectionTitle}" />

                    --><!-- ── Повідомлення про помилку ── --><!--
                    <Border BackgroundColor="#FEF2F2"
                            Stroke="#FCA5A5"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            Padding="14,10"
                            IsVisible="{Binding HasError}">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="⚠"
                                   FontSize="16"
                                   TextColor="{StaticResource Danger}"
                                   VerticalOptions="Center" />
                            <Label Text="{Binding ErrorMessage}"
                                   FontSize="13"
                                   TextColor="{StaticResource Danger}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    --><!-- ── Кроки симплекс-методу ── --><!--
                    <VerticalStackLayout Spacing="12"
                                         BindableLayout.ItemsSource="{Binding SolutionSteps}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                --><!--
                                    SolutionStepViewModel:
                                        Title       : string  → "Початковий крок" / "Ітерація 1"
                                        Description : string  → пояснення дій на цьому кроці
                                        HasTable    : bool
                                        TableRows   : ObservableCollection<SimplexTableRowViewModel>
                                            SimplexTableRowViewModel:
                                                BasisVar   : string
                                                Cb         : string
                                                P          : string
                                                Cells      : ObservableCollection<CellViewModel>
                                                    CellViewModel:
                                                        Value        : string
                                                        IsHighlighted: bool  → опорний елемент
                                                        IsEntering   : bool  → стовпець, що входить
                                                        IsLeaving    : bool  → рядок, що виходить
                                                Q          : string
                                                IsEstimate : bool  → останній рядок (оцінки)
                                --><!--
                                <Border BackgroundColor="{AppThemeBinding
                                            Light=#F8FAFC, Dark=#162030}"
                                        Stroke="{AppThemeBinding
                                            Light={StaticResource BorderLight},
                                            Dark={StaticResource BorderDark}}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="14">
                                    <VerticalStackLayout Spacing="8">

                                        --><!-- Заголовок кроку --><!--
                                        <Label Text="{Binding Title}"
                                               FontAttributes="Bold"
                                               FontSize="14"
                                               TextColor="{StaticResource Primary}" />

                                        --><!-- Опис / пояснення --><!--
                                        <Label Text="{Binding Description}"
                                               FontSize="12"
                                               LineBreakMode="WordWrap"
                                               TextColor="{AppThemeBinding
                                                   Light={StaticResource TextSecondary},
                                                   Dark={StaticResource TextSecondaryDark}}"
                                               IsVisible="{Binding HasDescription}" />

                                        --><!-- ─── Симплекс-таблиця ─── -->
                                        <!--
                                            ПРИМІТКА: Таблиця будується у code-behind або через
                                            ContentView/CustomView, бо кількість стовпців динамічна.
                                            Тут залишено ScrollView як контейнер-плейсхолдер.
                                            Рекомендована реалізація: Grid програмно або DataGrid
                                            від CommunityToolkit.
                                        --><!--
                                        <ScrollView Orientation="Horizontal"
                                                    HorizontalScrollBarVisibility="Always"
                                                    IsVisible="{Binding HasTable}">
                                            --><!--
                                                Вставити сюди кастомний SimplexTableView:
                                                <views:SimplexTableView
                                                    Rows="{Binding TableRows}" />
                                            --><!--
                                            <ContentView x:Name="TablePlaceholder"
                                                         BindingContext="{Binding}"
                                                         MinimumWidthRequest="300" />
                                        </ScrollView>

                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    --><!-- ── Оптимальний розв'язок (фінальний блок) ── --><!--
                    <Border BackgroundColor="{AppThemeBinding
                                Light=#EFF6FF, Dark=#0D2744}"
                            Stroke="{StaticResource Primary}"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 12"
                            Padding="16"
                            IsVisible="{Binding HasOptimalSolution}">
                        <VerticalStackLayout Spacing="8">

                            <HorizontalStackLayout Spacing="8">
                                <Label Text="✅"
                                       FontSize="18"
                                       VerticalOptions="Center" />
                                <Label Text="Оптимальний розв'язок"
                                       FontAttributes="Bold"
                                       FontSize="15"
                                       TextColor="{StaticResource Primary}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <BoxView Style="{StaticResource Divider}" Margin="0,0" />

                            --><!-- F* = ... --><!--
                            <Label Text="{Binding OptimalValueText}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding
                                       Light={StaticResource TextPrimary},
                                       Dark={StaticResource TextPrimaryDark}}" />

                            --><!-- x₁ = ...,  x₂ = ..., ... --><!--
                            <Label Text="{Binding OptimalVariablesText}"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding
                                       Light={StaticResource TextSecondary},
                                       Dark={StaticResource TextSecondaryDark}}" />

                        </VerticalStackLayout>
                    </Border>

                    --><!-- ── Кнопка копіювання результату ── --><!--
                    <Button Text="📋 Копіювати результат"
                            Command="{Binding CopyResultCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Primary}"
                            FontSize="13"
                            HorizontalOptions="End"
                            HeightRequest="36"
                            IsVisible="{Binding HasOptimalSolution}" />

                </VerticalStackLayout>
            </Border>-->

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
