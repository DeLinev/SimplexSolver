<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:SimplexMethodApp.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:controls="clr-namespace:SimplexMethodApp.Controls"
             xmlns:solution="clr-namespace:SimplexMethodApp.ViewModels.Simplex"
             x:DataType="viewmodel:MainViewModel"
             x:Class="SimplexMethodApp.MainPage"
             Title="Simplex Method App">

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <toolkit:IsStringNotNullOrEmptyConverter x:Key="StringToBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <CollectionView
        ItemsSource="{Binding SolutionSteps}"
        BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight},
                                          Dark={StaticResource BackgroundDark}}">
        <CollectionView.Header>
            <VerticalStackLayout Padding="16,14,16,0" Spacing="0">

            <!-- ─────────────────────────────────────────────────────────
                 HEADER
                 ───────────────────────────────────────────────────────── -->
            <VerticalStackLayout Spacing="4" Margin="0,0,0,20">
                <Label Text="Симплекс Метод"
                       FontSize="26"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource Primary}" />
                <Label Text="Розв'язання задач лінійного програмування"
                       FontSize="13"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource TextSecondary}" />
            </VerticalStackLayout>

            <!-- ─────────────────────────────────────────────────────────
                 CARD 1 — PROBLEM PARAMETERS
                 ───────────────────────────────────────────────────────── -->
            <Border Style="{StaticResource Card}" IsEnabled="{Binding IsNotBusy}">
                <VerticalStackLayout Spacing="7">

                    <Label Text="⚙  Параметри задачі"
                           Style="{StaticResource SectionTitle}" />

                    <!-- ── Number of variables ── -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Кількість змінних"
                               FontSize="13"
                               TextColor="{StaticResource TextSecondary}" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">

                            <Picker Grid.Column="0"
                                    Style="{StaticResource CompactPicker}"
                                    ItemsSource="{Binding VariableCountOptions}"
                                    SelectedItem="{Binding SelectedVariableOption, Mode=TwoWay}"
                                    Title="Оберіть кількість..." />

                            <Border Grid.Column="1"
                                    Stroke="{StaticResource Primary}"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 8"
                                    MinimumWidthRequest="100"
                                    IsVisible="{Binding IsCustomVariableCount}">
                                <controls:NumericEntry Text="{Binding CustomVariableCount}"
                                       Placeholder="N ≤ 20"
                                       Keyboard="Numeric"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"
                                       HorizontalOptions="Fill" 
                                       VerticalOptions="Fill"
                                       TextColor="{AppThemeBinding
                                           Light={StaticResource TextPrimary},
                                           Dark={StaticResource TextPrimaryDark}}"
                                       BackgroundColor="Transparent" />
                            </Border>

                        </Grid>
                    </VerticalStackLayout>

                    <BoxView Style="{StaticResource Divider}" />

                    <!-- ── Number of constraints ── -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Кількість обмежень"
                               FontSize="13"
                               TextColor="{StaticResource TextSecondary}" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">

                            <Picker Grid.Column="0"
                                    Style="{StaticResource CompactPicker}"
                                    ItemsSource="{Binding ConstraintCountOptions}"
                                    SelectedItem="{Binding SelectedConstraintOption}"
                                    Title="Оберіть кількість..." />

                            <Border Grid.Column="1"
                                    Stroke="{StaticResource Primary}"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 8"
                                    MinimumWidthRequest="100"
                                    IsVisible="{Binding IsCustomConstraintCount}">
                                <controls:NumericEntry Text="{Binding CustomConstraintCount}"
                                       Placeholder="M ≤ 20"
                                       Keyboard="Numeric"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"
                                       HorizontalOptions="Fill" 
                                       VerticalOptions="Fill"
                                       TextColor="{AppThemeBinding
                                           Light={StaticResource TextPrimary},
                                           Dark={StaticResource TextPrimaryDark}}"
                                       BackgroundColor="Transparent" />
                            </Border>

                        </Grid>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- ─────────────────────────────────────────────────────────
                 CARD 2 — OBJECTIVE FUNCTION
                 ───────────────────────────────────────────────────────── -->
            <Border Style="{StaticResource Card}" IsEnabled="{Binding IsNotBusy}">
                <VerticalStackLayout Spacing="10">

                    <Label Text="🎯  Цільова функція"
                           Style="{StaticResource SectionTitle}" />

                    <ScrollView Orientation="Horizontal">
                        <HorizontalStackLayout Spacing="0" VerticalOptions="Center" Margin="0,4">

                            <!--"F(x) ="-->
                            <Label Text="F(x) ="
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"
                                   VerticalOptions="Center"
                                   Margin="0,0,6,0" />

                            <!--[cᵢ] xᵢ +-->
                            <HorizontalStackLayout VerticalOptions="Center"
                                            BindableLayout.ItemsSource="{Binding ObjectiveCoefficients}">

                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodel:ObjTermViewModel">
                                        
                                        <!--ObjTermViewModel:
                                            Value         : string  ← Entry
                                            VariableLabel : string  → "x₁", "x₂", ...
                                            Separator     : string  → " + " or ""-->

                                        <HorizontalStackLayout Spacing="0"
                                                               VerticalOptions="Center" >
                                            
                                            <controls:NumericEntry Style="{StaticResource CoeffEntry}"
                                                       Text="{Binding Value}"
                                                       HorizontalTextAlignment="Center"
                                                       VerticalTextAlignment="Center"
                                                       Placeholder="c" />

                                            <Label Text="{Binding DisplayLabel}"
                                                   Style="{StaticResource BodyText}"
                                                   FontAttributes="Italic"
                                                   Margin="3,0,0,0" />

                                        </HorizontalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>

                            <!--"→"-->
                            <Label Text=" →"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   TextColor="{StaticResource TextSecondary}"
                                   Margin="4,0" />

                            <!--max / min Picker-->
                            <Border Stroke="{StaticResource Primary}"
                                    StrokeThickness="2"
                                    StrokeShape="RoundRectangle 8">
                                <Picker Style="{StaticResource CompactPicker}"
                                        ItemsSource="{Binding OptimizationOptions}"
                                        SelectedItem="{Binding SelectedOptimizationOption}"
                                        WidthRequest="85"
                                        FontAttributes="Bold"
                                        IsEnabled="{Binding IsNotBusy}"
                                        TextColor="{StaticResource Primary}" />
                            </Border>

                        </HorizontalStackLayout>
                    </ScrollView>

                </VerticalStackLayout>
            </Border>

            <!-- ─────────────────────────────────────────────────────────
                 CARD 3 — SYSTEM OF CONSTRAINTS
                 ───────────────────────────────────────────────────────── -->
            <Border Style="{StaticResource Card}" IsEnabled="{Binding IsNotBusy}">
                <VerticalStackLayout Spacing="10">

                    <!--<Grid ColumnDefinitions="*,Auto">-->
                        <Label Grid.Column="0"
                               Text="📋  Система обмежень"
                               Style="{StaticResource SectionTitle}"
                               Margin="0" />
                        
                        <!--<Label Grid.Column="1"
                               Text="xᵢ ≥ 0"
                               FontSize="13"
                               FontAttributes="Italic"
                               TextColor="{StaticResource TextSecondary}"
                               VerticalOptions="Center" />-->      
                    <!--</Grid>-->

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">

                        <Label Grid.Column="0"
                               Text="{}{"
                               FontSize="56"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               VerticalTextAlignment="Center"
                               HorizontalTextAlignment="Center"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Padding="0,0,0,10"
                               Margin="0,0,4,0" />

                        <ScrollView Grid.Column="1" 
                                    Orientation="Both" 
                                    VerticalOptions="Center"
                                    MaximumHeightRequest="300"> 

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Constraints}"
                                     Spacing="12"
                                     Padding="0,0,10,0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodel:ConstraintRowViewModel">

                                        <HorizontalStackLayout Spacing="0" VerticalOptions="Center" Margin="0,4">

                                            <!-- Coefficients aᵢⱼ xⱼ + -->
                                            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Coefficients}" 
                                                       Spacing="0" 
                                                       VerticalOptions="Center">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="viewmodel:ConstraintCoeffViewModel">

                                                        <Grid ColumnDefinitions="Auto, Auto" ColumnSpacing="2" Margin="0,0,4,0">
                                                            <controls:NumericEntry Grid.Column="0"
                                                                       Style="{StaticResource CoeffEntry}"
                                                                       Text="{Binding Value}"
                                                                       HorizontalTextAlignment="Center"
                                                                       VerticalTextAlignment="Center"
                                                                       Placeholder="a" />
                                                            <Label Grid.Column="1"
                                                                   Text="{Binding DisplayLabel}"
                                                                   Style="{StaticResource BodyText}"
                                                                   FontAttributes="Italic"
                                                                   VerticalOptions="Center" />  
                                                        </Grid>

                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </HorizontalStackLayout>

                                            <!-- Sign: ≤ / = / ≥ -->
                                            <Border Stroke="{StaticResource Primary}"
                                                    StrokeThickness="1.5"
                                                    StrokeShape="RoundRectangle 8"
                                                    Margin="6,0">
                                                <Picker Style="{StaticResource CompactPicker}"
                                                        ItemsSource="{Binding SignOptions}"
                                                        SelectedItem="{Binding SelectedSign}"
                                                        WidthRequest="78"
                                                        TextColor="{StaticResource Primary}"
                                                        FontAttributes="Bold" />        
                                            </Border>

                                            <!-- Right-hand side bᵢ -->

                                                <controls:NumericEntry Style="{StaticResource CoeffEntry}"
                                                           Text="{Binding RhsValue}"
                                                           Placeholder="b"
                                                           HorizontalTextAlignment="Center"
                                                           VerticalTextAlignment="Center"
                                                           WidthRequest="68" />

                                        </HorizontalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                        </ScrollView>
                    </Grid>

                        <Border BackgroundColor="{AppThemeBinding Light=#EFF6FF, Dark=#0D2744}"
                                Stroke="{StaticResource Primary}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                Padding="12,8"> 
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="де"
                                       FontSize="14"
                                       FontAttributes="Italic"
                                       TextColor="{StaticResource TextSecondary}"
                                       VerticalOptions="Center" />
                                <Label Text="x₁, x₂, ..., xₙ ≥ 0"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}"
                                       VerticalOptions="Center" />  
                            </HorizontalStackLayout>
                        </Border>
                    
                    </VerticalStackLayout>
            </Border>

            <!-- ─────────────────────────────────────────────────────────
                 ACTIONS
                 ───────────────────────────────────────────────────────── -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,0,0,14">

                <Button Grid.Column="0"
                        Text="🔄 Скинути"
                        Command="{Binding ClearCommand}"
                        Style="{StaticResource SecondaryButton}" />

                <Button Grid.Column="1"
                        Text="▶  Розв'язати"
                        Command="{Binding SolveCommand}"
                        IsVisible="{Binding SolveCommand.IsRunning, Converter={StaticResource InvertedBoolConverter}}"
                        Style="{StaticResource PrimaryButton}" />

                <Button Grid.Column="1"
                        Text="⬜️ Скасувати"
                        BackgroundColor="{StaticResource Danger}"
                        Command="{Binding SolveCancelCommand}"
                        IsVisible="{Binding SolveCommand.IsRunning}"
                        Style="{StaticResource PrimaryButton}" />

            </Grid>

            <!-- ─────────────────────────────────────────────────────────
             CARD 4 — ERRORS
             ───────────────────────────────────────────────────────── -->
            <Border Style="{StaticResource Card}" 
                    BackgroundColor="{StaticResource DangerLight}"
                    IsVisible="{Binding HasValidationErrors}">
                
                <VerticalStackLayout Spacing="5">
                
                    <Label Text="❌  Помилки"
                           Style="{StaticResource SectionTitle}" />

                    <VerticalStackLayout Spacing="4"
                             BindableLayout.ItemsSource="{Binding ValidationErrors}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="•"
                                           TextColor="{StaticResource Danger}"
                                           FontSize="14"
                                           VerticalOptions="Center"/>
                                    <Label Text="{Binding .}"
                                           TextColor="{StaticResource Danger}"
                                           FontSize="13"
                                           VerticalOptions="Center"/>   
                                </HorizontalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
                
            </Border>

            <!-- ─────────────────────────────────────────────────────────
                 SOLUTION STEPS & OPTIMAL SOLUTION
                 ───────────────────────────────────────────────────────── -->
            <Border Style="{StaticResource Card}"
                    IsVisible="{Binding IsSolutionVisible}"
                    Margin="0,0,0,0">
                <VerticalStackLayout Spacing="6">
                    <Label Text="📊  Результат"
                           Style="{StaticResource SectionTitle}" />
                    <Label Text="{Binding OptimalValue}"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{Binding SolutionStatusColor}" />
                    <Label Text="{Binding OptimalVariables}"
                           FontSize="18"
                           TextColor="{StaticResource TextSecondary}"
                           IsVisible="{Binding OptimalVariables,
                               Converter={StaticResource StringToBoolConverter}}" />
                </VerticalStackLayout>
            </Border>

            <BoxView Style="{StaticResource Divider}" 
                     Color="{StaticResource Gray200}"
                     HeightRequest="1.5"
                     WidthRequest="100"
                     Margin="0,20"/>

            <Label Text="🔢  Покроковий розв'язок"
                   Style="{StaticResource SectionTitle}"
                   IsVisible="{Binding IsSolutionVisible}"
                   Margin="0,0,0,10"/>
                
            </VerticalStackLayout>
        </CollectionView.Header>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="solution:SolutionStepViewModel">
                <Grid Padding="16,0,16,12">
                    <Border Style="{StaticResource Card}" >
                        <VerticalStackLayout Spacing="10" >

                            <!-- Step header -->
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{Binding TypeIcon}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center" />
                                <Label Text="{Binding Title}"
                                       FontAttributes="Bold"
                                       FontSize="14"
                                       TextColor="{Binding TitleColor}"
                                       VerticalOptions="Center" />  
                            </HorizontalStackLayout>

                            <!-- Description -->
                            <Label Text="{Binding Description}"
                               FontSize="12"
                               LineBreakMode="WordWrap"
                               TextColor="{StaticResource TextSecondary}"
                               IsVisible="{Binding Description,
                               Converter={StaticResource StringToBoolConverter}}" />
                            
                            <!-- Equations -->
                            <Border IsVisible="{Binding HasEquations}"
                                    BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F2132}"
                                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="12,8">
                                <VerticalStackLayout
                                    Spacing="4"
                                    BindableLayout.ItemsSource="{Binding Equations}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Label Text="{Binding .}"
                                                   FontFamily="Courier New"
                                                   FontSize="15"
                                                   TextColor="{AppThemeBinding
                                                       Light={StaticResource TextPrimary},
                                                       Dark={StaticResource TextPrimaryDark}}" />   
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Table -->
                            <ScrollView Orientation="Horizontal"
                                        IsVisible="{Binding HasTable}"
                                        HorizontalScrollBarVisibility="Default">
                                <VerticalStackLayout
                                        Spacing="1"
                                        HorizontalOptions="Start"
                                        BindableLayout.ItemsSource="{Binding TableRows}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="solution:SimplexTableRowViewModel">

                                            <HorizontalStackLayout
                                                    BackgroundColor="{Binding RowBackground}"
                                                    Spacing="1"
                                                    HorizontalOptions="Start"
                                                    BindableLayout.ItemsSource="{Binding Cells}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="solution:SimplexTableCellViewModel">

                                                        <Label Text="{Binding Text}"
                                                           WidthRequest="80"
                                                           HeightRequest="36"
                                                           BackgroundColor="{Binding Background}"
                                                           TextColor="{Binding TextColor}"
                                                           FontAttributes="{Binding FontWeight}"
                                                           FontSize="15"
                                                           HorizontalOptions="Fill"
                                                           VerticalOptions="Fill"
                                                           HorizontalTextAlignment="Center"
                                                           VerticalTextAlignment="Center"
                                                           Padding="0,0" />

                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </HorizontalStackLayout>

                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </ScrollView>

                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
        
    </CollectionView>

</ContentPage>
